# AI-SRE Cluster Manager Configuration

# Database & Storage
AI_SRE_DB_PATH=./data/lancedb
AI_SRE_AUDIT_LOG_PATH=./data/audit/audit.jsonl

# Security & Capability Gate
# Leave blank to generate secure ephemeral secrets at boot
AI_SRE_SALT=
AI_SRE_GATE_SECRET=
AI_SRE_DEFAULT_TTL=300

# OpenTelemetry Exporter (Optional: leave blank for in-memory/console)
OTEL_EXPORTER_OTLP_ENDPOINT=

